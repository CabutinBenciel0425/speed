# Backend environment template. Add real values in Render's Environment settings.
NODE_ENV=production

ACCESS_TOKEN_SECRET_KEY=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET_KEY=replace-with-a-different-long-random-secret
TEMP_TOKEN_SECRET_KEY=replace-with-a-third-long-random-secret

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
REDIS_URL=rediss://<user>:<password>@<host>:<port>

PAYMONGO_SECRET_KEY=sk_test_replace-me
PAYMONGO_PUBLIC_KEY=pk_test_replace-me
PAYMONGO_WEBHOOK_SECRET=whsk_replace-me

CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_SECRET=replace-me
OPENROUTE_API_KEY=replace-me

EMAIL_USER=replace-me
EMAIL_PASS=replace-me

ADMIN_EMAIL=admin@example.com
ADMIN_PASS=replace-with-a-strong-password
ADMIN_PHONENUMBER=replace-me

# Exact browser origin, with scheme and no trailing slash or path.
CLIENT_URL=https://<frontend-domain>

# Optional app defaults.
RANDOM_PROFILE_URL=
